<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#E02372"
                android:endColor="#7A00CC" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#FF2A85"
                android:endColor="#9A00FF" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>

</selector>
