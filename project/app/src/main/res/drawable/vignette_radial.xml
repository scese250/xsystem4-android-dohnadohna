<?xml version="1.0" encoding="utf-8"?>
<!-- Radial vignette: transparent in the middle, nearly opaque at the edges.
     A dp radius is used instead of "100%p" because GradientDrawable treats
     fraction values as pixels on API 21, which would swallow the whole screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="480dp"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#00000000"
        android:centerColor="#00000000"
        android:endColor="#ED080412" />
</shape>
