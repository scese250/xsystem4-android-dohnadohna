<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF000000" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:endColor="#FF231838"
                        android:startColor="#FF3A2756"
                        android:type="linear" />
                    <corners android:radius="8dp" />
                    <stroke
                        android:width="2dp"
                        android:color="#FFFF2DB8" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF000000" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:endColor="#FF1C152A"
                        android:startColor="#FF2F2245"
                        android:type="linear" />
                    <corners android:radius="8dp" />
                    <stroke
                        android:width="2dp"
                        android:color="#66FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
