<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#00B5DE"
                android:endColor="#00CEDB" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#CCFFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#00D2FF"
                android:endColor="#00F0FF" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#CCFFFFFF" />
        </shape>
    </item>

</selector>
