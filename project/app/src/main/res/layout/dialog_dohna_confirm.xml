<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dohna_dialog_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B80A0614"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <View
        android:id="@+id/dohna_dialog_focus_glow"
        android:layout_width="460dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:background="@drawable/dohna_dialog_focus_glow"
        android:clickable="false"
        android:focusable="false" />

    <io.github.kichikuou.xsystem4.DohnaDialogCardView
        android:id="@+id/dohna_dialog_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Header bar inside yellow #FBEE03 region -->
        <LinearLayout
            android:id="@+id/dohna_dialog_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/dohna_dialog_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/dohna_dialog_badge_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/dohna_dialog_badge_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning_triangle"
                    android:tint="#FFB8FF00" />

                <TextView
                    android:id="@+id/dohna_dialog_badge_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:textColor="#FFB8FF00"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/dohna_dialog_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/dohna_dialog_close_bg"
                android:contentDescription="@string/cancel"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_dialog_close" />
        </LinearLayout>

        <!-- Dialog body -->
        <LinearLayout
            android:id="@+id/dohna_dialog_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <io.github.kichikuou.xsystem4.BoundedScrollView
                android:id="@+id/dohna_dialog_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dohna_dialog_question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:shadowColor="#FF000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="1"
                        android:textColor="#FFFFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/dohna_dialog_warning_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/dohna_dialog_warning_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="7dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/dohna_dialog_warning_icon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_warning_triangle"
                            android:tint="#FFFBEE03" />

                        <TextView
                            android:id="@+id/dohna_dialog_warning_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.15"
                            android:textColor="#FFFFB8CC"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </io.github.kichikuou.xsystem4.BoundedScrollView>

            <LinearLayout
                android:id="@+id/dohna_dialog_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal" />
        </LinearLayout>
    </io.github.kichikuou.xsystem4.DohnaDialogCardView>
</FrameLayout>
