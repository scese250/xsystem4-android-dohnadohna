<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_bg">

    <!-- ============================================================
         BACKGROUND OVERLAYS (always below the content screens)
         0: halftone dot grid
         1: radial vignette
         ============================================================ -->
    <io.github.kichikuou.xsystem4.HalftoneOverlayView
        android:id="@+id/halftone_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <View
        android:id="@+id/vignette_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette_radial"
        android:clickable="false"
        android:focusable="false" />

    <!-- ============================================================
         STATE 1: PERMISSION REQUIRED
         Shown when All Files Access is not granted.
         ============================================================ -->
    <LinearLayout
        android:id="@+id/screen_permission"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:shadowColor="#B3FF2A85"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="24"
            android:text="@string/perm_title"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:text="@string/perm_desc"
            android:textColor="@color/dd_neon_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/permission_button"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/btn_pink_gradient"
            android:elevation="6dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:minWidth="240dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:stateListAnimator="@null"
            android:text="@string/perm_button"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ============================================================
         STATE 2: LOCATE GAME
         Shown when permission is granted but no game folder was found.
         ============================================================ -->
    <LinearLayout
        android:id="@+id/screen_locate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:shadowColor="#9900F0FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20"
            android:text="@string/locate_title"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_locate_game"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/btn_cyan_gradient"
            android:elevation="6dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:minWidth="240dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:stateListAnimator="@null"
            android:text="@string/locate_button"
            android:textAllCaps="true"
            android:textColor="#080614"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ============================================================
         STATE 3: GAME READY
         [Left gestures] | [Title + icon + Start] | [Right gestures]
         ============================================================ -->
    <LinearLayout
        android:id="@+id/screen_game_ready"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- Left gesture column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <include layout="@layout/gesture_btn_left_click" />

            <include layout="@layout/gesture_btn_right_click" />

            <include layout="@layout/gesture_btn_fast_skip" />

        </LinearLayout>

        <!-- Center column: title + icon + Start Game -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical">

            <io.github.kichikuou.xsystem4.StrokedTextView
                android:id="@+id/game_title_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/game_title_display"
                android:textAllCaps="true"
                android:textColor="@color/dd_title_fill"
                android:textSize="22sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:background="@drawable/icon_glow_bg"
                    android:clickable="false"
                    android:focusable="false" />

                <ImageView
                    android:id="@+id/game_icon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/icon_bg_rounded"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:elevation="6dp"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/dohna_icon" />
            </FrameLayout>

            <io.github.kichikuou.xsystem4.CyberStartButton
                android:id="@+id/btn_start_game"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Right gesture column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <include layout="@layout/gesture_btn_backlog" />

            <include layout="@layout/gesture_btn_close_menu" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
