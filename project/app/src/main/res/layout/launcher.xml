<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ListView android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp" />

    <ScrollView android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:paddingBottom="96dp">

            <TextView android:id="@+id/no_games"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_games"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:paddingBottom="8dp" />

            <Button android:id="@+id/add_folder_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:minHeight="72dp"
                android:text="@string/add_folder_empty_button"
                android:textAllCaps="false"
                android:textSize="20sp" />

            <TextView android:id="@+id/usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>

    <ScrollView android:id="@+id/permission_required"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp">

            <TextView android:id="@+id/permission_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/permission_required_message"
                android:textSize="16sp" />

            <Button android:id="@+id/permission_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="56dp"
                android:text="@string/permission_button"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/add_folder_fab"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/fab_background"
        android:elevation="6dp"
        android:padding="0dp"
        android:text="@string/add_folder_plus"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:contentDescription="@string/add_folder_empty_button" />
</FrameLayout>
